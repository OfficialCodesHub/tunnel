#!/bin/bash
# ══════════════════════════════════════════════════════════════════
#  AyushTheWarrior Tunnel v1.0 - Advanced Port Forwarding
# ══════════════════════════════════════════════════════════════════

SERVER="teri"
USER="ubuntu" 
SSH_PORT=22

CONFIG_DIR="$HOME/.astranode-tunnel"
KEY_FILE="$CONFIG_DIR/.key"
LOG_DIR="$CONFIG_DIR/logs"
PID_DIR="$CONFIG_DIR/pids"
mkdir -p "$CONFIG_DIR" "$LOG_DIR" "$PID_DIR" 2>/dev/null
chmod 700 "$CONFIG_DIR" 2>/dev/null

# Colors
RED="\e[31m"; GRN="\e[32m"; YEL="\e[33m"; CYN="\e[36m"; WHT="\e[97m"
GRY="\e[90m"; BOLD="\e[1m"; DIM="\e[2m"; UNDER="\e[4m"; BLINK="\e[5m"; RST="\e[0m"

# ══════════════════════════════════════════════════════════════════
#  EMBEDDED RESTRICTED SSH KEY (can ONLY forward ports)
# ══════════════════════════════════════════════════════════════════
setup_key(){
if [ ! -f "$KEY_FILE" ];then
cat>"$KEY_FILE"<<'KEY'
-----BEGIN RSA PRIVATE KEY-----

C+dt+QKBgC7qPo3Oa1HI/tFZw+ER5/Ahu+Lh3dQ5j7wvpzl/rWaa1lFhbjt/HSKP
5vij71MLoTV0NISgNnyxrWcIFdTv4GM2Qqy/K5SyTEXvJ52qOExNsQutJHr/ntSG
xLKUiB8ev9WrXpyIYm1hjLA4wTOMWOrqlwdETgEw6OVJxiVLvBuR
-----END RSA PRIVATE KEY----- 
KEY
chmod 600 "$KEY_FILE"
fi
}

# ══════════════════════════════════════════════════════════════════
#  DISPLAY FUNCTIONS
# ══════════════════════════════════════════════════════════════════

banner(){
clear
echo -e "${CYN}${BOLD}"
echo "   ╔════════════════════════════════════════════════════╗"
echo "   ║                                                    ║"
echo "   ║        ${WHT}⚡  AyushTheWarrior Tunnel v1.0  ⚡${CYN}         ║"
echo "   ║                                                    ║"
echo "   ║         ${DIM}Secure Port Forwarding Service${CYN}          ║"
echo "   ║                                                    ║"
echo "   ╚════════════════════════════════════════════════════╝"
echo -e "${RST}"
echo -e "${GRY}${DIM}   Server: $SERVER  •  🔒 Secure  •  Status: ${GRN}ONLINE${RST}"
echo
}

box(){
local msg="$1"
local color="${2:-$GRN}"
echo -e "${color}${BOLD}"
echo "   ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓"
echo "   ┃   $msg"
echo "   ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛"
echo -e "${RST}"
}

dots(){
printf "   ${CYN}$1${RST}"
for i in 1 2 3;do printf ".";sleep 0.15;done
echo
}

# ══════════════════════════════════════════════════════════════════
#  TUNNEL OPERATIONS
# ══════════════════════════════════════════════════════════════════

start_tunnel(){
local port="$1"
local pid_file="$PID_DIR/tunnel-$port.pid"
local map_file="$CONFIG_DIR/.port-$port"
local log_file="$LOG_DIR/tunnel-$port.log"

banner

# Validate port
if [ $port -lt 1 ]||[ $port -gt 65535 ];then
echo -e "   ${RED}✗${RST} ${BOLD}Invalid port${RST} (must be 1-65535)"
return 1
fi

# Check if running
if [ -f "$pid_file" ];then
local pid=$(cat "$pid_file")
if kill -0 "$pid" 2>/dev/null;then
local remote=$(cat "$map_file" 2>/dev/null||echo "?")
echo -e "   ${YEL}⚠${RST} Tunnel already active for port ${BOLD}$port${RST}"
echo
echo -e "   ${CYN}🔗${RST} Public URL: ${GRN}${BOLD}http://$SERVER:$remote${RST}"
echo
return 0
fi
fi

setup_key

# Display info
echo -e "   ${CYN}🚀${RST} ${BOLD}Starting Tunnel${RST}"
echo
echo -e "   ${GRY}Local:${RST}    ${WHT}${BOLD}localhost:$port${RST}"
echo -e "   ${GRY}Server:${RST}   ${WHT}$SERVER${RST}"
echo -e "   ${GRY}Security:${RST} ${GRN}🔒 SSH Key Auth${RST}"
echo

dots "Connecting"

# Start tunnel
ssh -i "$KEY_FILE" \
-o StrictHostKeyChecking=no \
-o UserKnownHostsFile=/dev/null \
-o ExitOnForwardFailure=yes \
-o ServerAliveInterval=30 \
-o ServerAliveCountMax=3 \
-o ConnectTimeout=10 \
-N -f \
-R 0:localhost:$port \
$USER@$SERVER \
-p $SSH_PORT \
>"$log_file" 2>&1

sleep 3

# Get remote port
if grep -q "Allocated port" "$log_file" 2>/dev/null;then
local remote_port=$(grep "Allocated port" "$log_file"|grep -oE '[0-9]{4,5}'|head -1)
echo "$remote_port">"$map_file"
local ssh_pid=$(pgrep -f "ssh.*-R.*$port.*$SERVER"|head -1)
[ -n "$ssh_pid" ]&&echo "$ssh_pid">"$pid_file"

echo
box "✓  TUNNEL ACTIVE  ✓" "$GRN"
echo
echo -e "   ${BOLD}═══ Connection Details ═══${RST}"
echo
echo -e "   ${GRY}├─${RST} Local:  ${WHT}localhost:$port${RST}"
echo -e "   ${GRY}├─${RST} Remote: ${GRN}${BOLD}$remote_port${RST}"
echo -e "   ${GRY}├─${RST} PID:    ${GRY}$ssh_pid${RST}"
echo -e "   ${GRY}└─${RST} Status: ${GRN}${BLINK}●${RST} ${GRN}ONLINE${RST}"
echo
echo -e "   ${CYN}${BOLD}🔥 Share This URL:${RST}"
echo
echo -e "      ${GRN}${BOLD}${UNDER}http://$SERVER:$remote_port${RST}"
echo
echo -e "   ${GRY}${DIM}💡 Tip: Run 'tunnel list' to see all tunnels${RST}"
echo
else
echo -e "   ${RED}✗${RST} Connection failed"
echo -e "   ${YEL}Log:${RST} $log_file"
return 1
fi
}

stop_tunnel(){
local port="$1"
local pid_file="$PID_DIR/tunnel-$port.pid"
local map_file="$CONFIG_DIR/.port-$port"

if [ ! -f "$pid_file" ];then
echo -e "   ${YEL}⚠${RST} No tunnel for port $port"
return 1
fi

local pid=$(cat "$pid_file")
dots "Stopping tunnel"

if kill "$pid" 2>/dev/null;then
rm -f "$pid_file" "$map_file"
echo -e "   ${GRN}✓${RST} Tunnel stopped for port ${BOLD}$port${RST}"
else
rm -f "$pid_file" "$map_file"
echo -e "   ${YEL}⚠${RST} Process not found"
fi
}

list_tunnels(){
banner
echo -e "   ${BOLD}${UNDER}Active Tunnels${RST}"
echo

local count=0
for pid_file in "$PID_DIR"/tunnel-*.pid;do
[ -f "$pid_file" ]||continue
local pid=$(cat "$pid_file" 2>/dev/null)
local port=$(basename "$pid_file" .pid|sed 's/tunnel-//')

if kill -0 "$pid" 2>/dev/null;then
local remote=$(cat "$CONFIG_DIR/.port-$port" 2>/dev/null||echo "?")
local start=$(stat -c %Y "$pid_file" 2>/dev/null||stat -f %m "$pid_file" 2>/dev/null||echo 0)
local now=$(date +%s)
local dur=$((now-start))
local time=""

if [ $dur -ge 3600 ];then
time="$((dur/3600))h $((dur%3600/60))m"
elif [ $dur -ge 60 ];then
time="$((dur/60))m $((dur%60))s"
else
time="${dur}s"
fi

count=$((count+1))
echo -e "   ${CYN}${BOLD}[$count]${RST} ${GRN}●${RST} ${BOLD}Port $port${RST}"
echo -e "       ${GRY}├─${RST} Local:    ${WHT}localhost:$port${RST}"
echo -e "       ${GRY}├─${RST} Remote:   ${GRN}${BOLD}http://$SERVER:$remote${RST}"
echo -e "       ${GRY}├─${RST} PID:      ${GRY}$pid${RST}"
echo -e "       ${GRY}└─${RST} Duration: ${WHT}$time${RST}"
echo
else
rm -f "$pid_file"
fi
done

if [ $count -eq 0 ];then
echo -e "   ${GRY}${DIM}No active tunnels${RST}"
echo
echo -e "   ${CYN}ℹ${RST} Start one with: ${BOLD}tunnel <port>${RST}"
echo -e "   ${CYN}ℹ${RST} Example: ${BOLD}tunnel 8080${RST}"
else
echo -e "   ${GRY}${DIM}─────────────────────────────────────────${RST}"
echo -e "   ${BOLD}Total:${RST} ${GRN}$count${RST} tunnel(s)"
fi
echo
}

stop_all(){
banner
echo -e "   ${YEL}🛑${RST} ${BOLD}Stopping all tunnels...${RST}"
echo

local count=0
for pid_file in "$PID_DIR"/tunnel-*.pid;do
[ -f "$pid_file" ]||continue
local port=$(basename "$pid_file" .pid|sed 's/tunnel-//')
local pid=$(cat "$pid_file")

if kill -0 "$pid" 2>/dev/null;then
kill "$pid" 2>/dev/null
rm -f "$pid_file" "$CONFIG_DIR/.port-$port"
echo -e "   ${GRN}✓${RST} Stopped port $port"
count=$((count+1))
fi
done

if [ $count -eq 0 ];then
echo -e "   ${GRY}${DIM}No active tunnels${RST}"
else
echo
echo -e "   ${GRN}${BOLD}✓ Stopped $count tunnel(s)${RST}"
fi
echo
}

show_help(){
banner
cat<<'EOF'
   USAGE

   tunnel <port>         Start tunnel
   tunnel stop <port>    Stop tunnel
   tunnel list           List all tunnels
   tunnel stop-all       Stop all tunnels
   tunnel help           Show this help

   EXAMPLES

   # Start tunnel for port 8080
   tunnel 8080

   # List all active tunnels
   tunnel list

   # Stop specific tunnel
   tunnel stop 8080

   # Stop all tunnels
   tunnel stop-all


   SECURITY

   🔒 Restricted SSH key (port forwarding only)
   🔒 Cannot login to server
   🔒 Cannot execute commands
   🔒 Automatic reconnection

EOF
}

# ══════════════════════════════════════════════════════════════════
#  MAIN
# ══════════════════════════════════════════════════════════════════

if ! command -v ssh &>/dev/null;then
echo -e "${RED}✗${RST} ssh not installed"
echo
echo "Install: sudo apt-get install openssh-client"
exit 1
fi

case "${1:-help}" in
[0-9]*)
start_tunnel "$1"
;;
stop)
[ -z "$2" ]&&{ banner;echo -e "   ${RED}✗${RST} Port required\n   Usage: tunnel stop <port>\n";exit 1;}
banner
stop_tunnel "$2"
echo
;;
list|ls)
list_tunnels
;;
stop-all|stopall)
stop_all
;;
help|--help|-h|"")
show_help
;;
*)
banner
echo -e "   ${RED}✗${RST} Unknown command: ${BOLD}$1${RST}"
echo
echo -e "   ${CYN}ℹ${RST} Run ${BOLD}tunnel help${RST} for usage"
echo
exit 1
;;
esac
